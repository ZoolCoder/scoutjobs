{
  "name": "ScoutJobs daily search",
  "nodes": [
    {"parameters": {"rule": {"interval": [{"field": "cronExpression", "expression": "30 7 * * 1-5"}]}}, "name": "Every weekday 07:30", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0]},
    {"parameters": {"method": "POST", "url": "http://127.0.0.1:7070/api/search", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "{\"add\": true, \"remote\": false, \"limit\": 60}", "options": {"timeout": 120000}}, "name": "POST /api/search", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [220, 0]},
    {"parameters": {"conditions": {"options": {"caseSensitive": true, "typeValidation": "loose"}, "conditions": [{"leftValue": "={{ $json.added }}", "rightValue": 0, "operator": {"type": "number", "operation": "gt"}}], "combinator": "and"}, "options": {}}, "name": "Only when something was added", "type": "n8n-nodes-base.filter", "typeVersion": 2, "position": [440, 0]},
    {"parameters": {"jsCode": "const r = $input.first().json;\nconst created = (r.postings || []).filter(p => p.created);\nconst lines = [`ScoutJobs search: ${r.added} new postings to score`];\nfor (const p of created.slice(0, 15)) lines.push(`- ${p.company}: ${p.title}${p.remote ? ' (' + p.remote + ')' : ''}`);\nif (created.length > 15) lines.push(`...and ${created.length - 15} more`);\nif ((r.errors || []).length) lines.push(`${r.errors.length} board errors`);\nlines.push('Score them: /scoutjobs:fit');\nreturn [{ json: { text: lines.join('\\n') } }];"}, "name": "Format", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [660, 0]},
    {"parameters": {"chatId": "={{ $env.TELEGRAM_CHAT_ID }}", "text": "={{ $json.text }}", "additionalFields": {}}, "name": "Telegram (swap for Slack/email)", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [880, 0]}
  ],
  "connections": {
    "Every weekday 07:30": {"main": [[{"node": "POST /api/search", "type": "main", "index": 0}]]},
    "POST /api/search": {"main": [[{"node": "Only when something was added", "type": "main", "index": 0}]]},
    "Only when something was added": {"main": [[{"node": "Format", "type": "main", "index": 0}]]},
    "Format": {"main": [[{"node": "Telegram (swap for Slack/email)", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
